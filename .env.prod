# =========================================
# CALL:ACT 운영 환경 설정 (.env.prod)
# =========================================
# ⚠️ 주의: 이 파일은 절대 Git에 커밋하지 마세요!
# EC2에서만 사용됩니다.

# ---------- 환경 설정 ----------
ENVIRONMENT=production
DEBUG=false

# ---------- OpenAI ----------
OPENAI_API_KEY=your-openai-key-here

# ---------- HuggingFace ----------
HF_TOKEN=your-hf-token-here

# ---------- RunPod ----------
RUNPOD_API_KEY=your-runpod-key-here

# ---------- 데이터베이스 (RDS) ----------
# RDS 엔드포인트를 여기에 입력
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_USER=callact_admin
DB_PASSWORD=your-strong-password-here
DB_NAME=callact_db

# ---------- Redis ----------
# 초기: EC2 내부 redis (localhost)
# 운영: ElastiCache 엔드포인트
DIALOGUE_REDIS_URL=redis://localhost:6379/0
RAG_REDIS_URL=redis://localhost:6379/0

# ---------- RAG 캐시 설정 ----------
RAG_CARD_CACHE=1
RAG_CARD_CACHE_TTL=120
GUIDE_USE_CONSULT_DOCS=0
RAG_FORCE_SEARCH=0

# ---------- LLM 설정 ----------
LLM_BASE_URL=http://213.192.2.118:40125
LLM_MODEL=sllm
LLM_PROVIDER=openai_compat

# ---------- 모델 캐시 디렉토리 ----------
MODEL_CACHE_DIR=/app/model_cache

# ---------- 로깅 ----------
LOG_LEVEL=INFO
